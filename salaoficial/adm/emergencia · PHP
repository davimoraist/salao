<?php
// Devolve (JSON) quantos agendamentos seriam cancelados num período.
// Só consulta, não altera nada. Uso: contar_emergencia.php?inicio=2026-10-20&fim=2026-10-22
session_start();
header('Content-Type: application/json; charset=utf-8');

if (empty($_SESSION['idusuario'])) {
    http_response_code(401);
    echo json_encode(['erro' => 'Não autorizado']);
    exit;
}

$inicio = $_GET['inicio'] ?? '';
$fim    = $_GET['fim'] ?? '';
$d1 = DateTime::createFromFormat('Y-m-d', $inicio);
$d2 = DateTime::createFromFormat('Y-m-d', $fim);

if (!$d1 || !$d2 || $d1->format('Y-m-d') !== $inicio || $d2->format('Y-m-d') !== $fim || $fim < $inicio) {
    http_response_code(400);
    echo json_encode(['erro' => 'Datas inválidas']);
    exit;
}

try {
    $pdo = new PDO("mysql:host=localhost;dbname=salao;charset=utf8", "root", "", [
        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    ]);

    $stmt = $pdo->prepare(
        "SELECT COUNT(*) AS total,
                COALESCE(SUM(t.pago > 0), 0) AS pagos,
                COALESCE(SUM(t.pago), 0) AS valor
           FROM (SELECT a.id, COALESCE(SUM(p.valor_pago), 0) AS pago
                   FROM agendamentos a
              LEFT JOIN pagamentos p ON p.id_agendamento = a.id
                  WHERE a.data_agendamento BETWEEN :inicio AND :fim
                    AND a.status IN ('confirmado', 'pendente')
               GROUP BY a.id) t"
    );
    $stmt->execute([':inicio' => $inicio, ':fim' => $fim]);
    $r = $stmt->fetch();

    echo json_encode([
        'total' => (int) $r['total'],
        'pagos' => (int) $r['pagos'],
        'valor' => (float) $r['valor'],
    ]);
} catch (PDOException $e) {
    error_log("contar_emergencia.php: " . $e->getMessage());
    http_response_code(500);
    echo json_encode(['erro' => 'Erro ao consultar']);
}